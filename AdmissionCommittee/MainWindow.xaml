<Window x:Class="AdmissionCommittee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приёмная комиссия"
        Height="780" Width="1240" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выйти"
                        Style="{StaticResource HeaderButton}"
                        Command="{Binding LogoutCommand}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding UserCaption}"
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Приёмная комиссия" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="регистрация абитуриентов, ведомость, рейтинг и зачисление"
                               Foreground="#D6E2F5" FontSize="12.5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Текущий экран: View подбирается по типу ViewModel (см. App.xaml) -->
        <ContentControl Content="{Binding CurrentView}" Margin="20,16,20,20"/>
    </DockPanel>
</Window>
