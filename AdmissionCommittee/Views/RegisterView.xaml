<UserControl x:Class="AdmissionCommittee.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:AdmissionCommittee.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="720" Padding="28" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация абитуриента" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                           Text="Выберите факультет и укажите средний балл аттестата. Баллы по предметам вы введёте в личном кабинете после регистрации."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: учётная запись и личные данные -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Учётная запись" Style="{StaticResource H2}"/>

                        <TextBlock Text="Логин (латиница, цифры)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Пароль (от 6 символов, буквы и цифры)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox inf:PasswordHelper.Attach="True"
                                     inf:PasswordHelper.Password="{Binding Password}"/>

                        <TextBlock Text="Повторите пароль" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox inf:PasswordHelper.Attach="True"
                                     inf:PasswordHelper.Password="{Binding PasswordConfirm}"/>

                        <TextBlock Text="Личные данные" Style="{StaticResource H2}" Margin="0,8,0,10"/>

                        <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding BirthDate}"/>

                        <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Правая колонка: факультет и аттестат -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Заявление" Style="{StaticResource H2}"/>

                        <TextBlock Text="Факультет" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Faculties}"
                                  SelectedItem="{Binding SelectedFaculty}"
                                  DisplayMemberPath="Name"/>

                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding FacultyInfo}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Средний балл аттестата (3,00 – 5,00)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CertificateText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Сумма конкурсных баллов = баллы по вступительным испытаниям + средний балл аттестата × 10."/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Зарегистрироваться" Command="{Binding RegisterCommand}" IsDefault="True"/>
                    <Button Content="Назад ко входу" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
