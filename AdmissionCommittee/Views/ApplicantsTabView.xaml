<UserControl x:Class="AdmissionCommittee.Views.ApplicantsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Поиск (ФИО или логин):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,16,0"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <Border DockPanel.Dock="Right" Width="320" Style="{StaticResource Card}" Margin="12,0,0,0" VerticalAlignment="Top">
            <StackPanel IsEnabled="{Binding HasSelection}">
                <TextBlock Text="Данные абитуриента" Style="{StaticResource H2}"/>
                <TextBlock Text="ФИО" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding EditBirthDate}"/>
                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Факультет" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Faculties}" SelectedItem="{Binding EditFaculty}" DisplayMemberPath="Name"/>
                <TextBlock Text="Средний балл аттестата" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditCertificateText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
                    <Button Content="Удалить заявление" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Applicants}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                <DataGridTextColumn Header="Факультет" Binding="{Binding FacultyName}" Width="170"/>
                <DataGridTextColumn Header="Аттестат" Binding="{Binding CertificateAvg, StringFormat={}{0:0.00}}" Width="75"/>
                <DataGridTextColumn Header="Дата рожд." Binding="{Binding BirthDate, StringFormat={}{0:dd.MM.yyyy}}" Width="95"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Подано" Binding="{Binding RegisteredAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="125"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
