<UserControl x:Class="AdmissionCommittee.Views.FacultiesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Новый факультет" Command="{Binding NewCommand}"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <Border DockPanel.Dock="Right" Width="340" Style="{StaticResource Card}" Margin="12,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}"/>
                <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="План набора (мест)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditPlanText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60" VerticalContentAlignment="Top"/>
                <TextBlock Text="Вступительные испытания" Style="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding SubjectChecks}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Faculties}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Факультет" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="План" Binding="{Binding PlanCount}" Width="60"/>
                <DataGridTextColumn Header="Заявлений" Binding="{Binding ApplicantsCount}" Width="85"/>
                <DataGridTextColumn Header="Предметы" Binding="{Binding SubjectsText}" Width="*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
