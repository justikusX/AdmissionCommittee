<UserControl x:Class="AdmissionCommittee.Views.RatingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Факультет:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding FacultyFilter}" SelectedItem="{Binding SelectedFacultyFilter}"
                      DisplayMemberPath="Name" Width="260" Margin="0,0,16,0"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Подвести итоги (зачисление)" Command="{Binding RunEnrollmentCommand}"
                    Style="{StaticResource SuccessButton}" Margin="16,0,8,0"/>
            <Button Content="Отменить итоги" Command="{Binding ResetEnrollmentCommand}" Style="{StaticResource DangerButton}"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Сумма = баллы по зарегистрированным предметам факультета + средний балл аттестата × 10. К конкурсу допускаются абитуриенты, у которых все предметы зарегистрированы с баллом не ниже минимального. Порядок: сумма ↓, аттестат ↓, дата подачи ↑."/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Passes}" Value="True">
                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEligible}" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Факультет" Binding="{Binding FacultyName}" Width="170"/>
                <DataGridTextColumn Header="Место" Binding="{Binding RankText, Mode=OneWay}" Width="60"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Экзамены" Binding="{Binding ExamSum}" Width="80"/>
                <DataGridTextColumn Header="Аттестат" Binding="{Binding CertificateAvg, StringFormat={}{0:0.00}}" Width="75"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalScore, StringFormat={}{0:0.#}}" Width="70"/>
                <DataGridTextColumn Header="План" Binding="{Binding PlanCount}" Width="55"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Примечание" Binding="{Binding Note, Mode=OneWay}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
