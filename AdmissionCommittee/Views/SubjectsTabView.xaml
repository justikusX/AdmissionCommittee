<UserControl x:Class="AdmissionCommittee.Views.SubjectsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Новый предмет" Command="{Binding NewCommand}"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>

        <Border DockPanel.Dock="Right" Width="320" Style="{StaticResource Card}" Margin="12,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}"/>
                <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Минимальный балл (0–100)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding EditMinText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                           Text="Предмет нельзя удалить, если он назначен факультету или по нему уже есть баллы в ведомости."/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Минимальный балл" Binding="{Binding MinScore}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
