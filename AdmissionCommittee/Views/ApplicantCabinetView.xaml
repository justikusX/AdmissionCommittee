<UserControl x:Class="AdmissionCommittee.Views.ApplicantCabinetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Левая часть: заявление и баллы ===== -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding FullName}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding ContactsText}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Факультет: " Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding FacultyName}" FontWeight="SemiBold"/>
                            <TextBlock Text="     Аттестат: " Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding CertificateText}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Баллы по вступительным испытаниям" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Введите баллы (0–100). Администратор проверит их и зарегистрирует в ведомости — после этого балл менять нельзя."/>

                        <ItemsControl ItemsSource="{Binding Scores}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="230"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SubjectName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MinScoreText}" VerticalAlignment="Center"
                                                       Style="{StaticResource Hint}"/>
                                            <TextBox Grid.Column="2" Margin="0,0,12,0"
                                                     Text="{Binding ScoreText, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding CanEdit}" MaxLength="3"
                                                     HorizontalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StateText}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBelowMin}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Сохранить баллы" Command="{Binding SaveScoresCommand}"/>
                            <Button Content="Обновить" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Правая часть: результат ===== -->
            <StackPanel Grid.Column="2">
                <Border Padding="16" CornerRadius="8" Margin="0,0,0,12" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnrolled}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrorLightBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Статус заявления" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding Status}" FontSize="22" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Конкурсный результат" Style="{StaticResource H2}"/>
                        <TextBlock Text="Сумма баллов" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding TotalText}" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding TotalDetailsText}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding RatingText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Сменить факультет" Style="{StaticResource H2}"/>
                        <ComboBox ItemsSource="{Binding Faculties}" SelectedItem="{Binding NewFaculty}"
                                  DisplayMemberPath="Name" IsEnabled="{Binding CanEdit}"/>
                        <Button Content="Перевести заявление" Command="{Binding ChangeFacultyCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Сменить факультет можно, пока не подведены итоги приёма."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
